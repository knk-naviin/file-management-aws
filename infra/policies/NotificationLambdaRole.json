{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishDeletionEventsToOneTopic",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:REPLACE_WITH_REGION:REPLACE_WITH_ACCOUNT_ID:secure-documents-deleted"
    },
    {
      "Sid": "WriteOnlyNotificationFunctionLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:REPLACE_WITH_REGION:REPLACE_WITH_ACCOUNT_ID:log-group:/aws/lambda/NotificationLambda:*"
    }
  ]
}
