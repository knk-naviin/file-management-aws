# Copy to .env, replace placeholders, then run the key-generation script.
DB_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
AWS_REGION=REPLACE_WITH_AWS_REGION
AWS_ACCESS_KEY_ID=REPLACE_WITH_SHORT_LIVED_OR_LOCALSTACK_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_OR_LOCALSTACK_SECRET
S3_BUCKET=REPLACE_WITH_YOUR_PRIVATE_BUCKET
KMS_KEY_ID=REPLACE_WITH_KMS_KEY_ARN_OR_ALIAS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# scripts/generate-dev-jwt-keys.ps1 writes development-only RSA key values here.
JWT_PRIVATE_KEY_BASE64=GENERATE_WITH_scripts_generate-dev-jwt-keys.ps1
JWT_PUBLIC_KEY_BASE64=GENERATE_WITH_scripts_generate-dev-jwt-keys.ps1
